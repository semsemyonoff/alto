# Copy to .env and adjust. Consumed by docker-compose.yml.

# Published image + tag to run. Pin to a release (e.g. 0.1.0) in production;
# `latest` is fine for trying it out. Point ALTO_IMAGE at the internal registry
# (git.horn/alto/alto) or the public one (semsemyonoff/alto) as you prefer.
ALTO_IMAGE=semsemyonoff/alto
ALTO_TAG=latest

# Host port the UI/API is exposed on (container always serves on 8080).
ALTO_HTTP_PORT=8080

# Libraries the app scans, as name:path pairs (container-side paths). Each entry
# here must have a matching host bind mount in docker-compose.yml — the two
# defaults below map to ALTO_MUSIC_DIR and ALTO_LOSSLESS_DIR. Add a library by
# extending this list AND adding its volume in the compose file. Names must match
# [a-zA-Z0-9_-] and be unique.
ALTO_LIBRARIES=Music:/music,Lossless:/lossless

# Host directories bind-mounted as the libraries above.
#   Read-only (:ro in compose) is safe ONLY for Shared /out output mode; the
#   local .alto-out/ and Replace modes write into the source and need a writable
#   mount — drop the :ro in docker-compose.yml for those.
ALTO_MUSIC_DIR=./music
ALTO_LOSSLESS_DIR=./lossless

# Host directory for transcoded output (Shared /out mode). Bind-mounted so the
# results are browsable on the host.
ALTO_OUTPUT_DIR=./out

# Number of concurrent transcode jobs (minimum 1). Extra jobs sit `queued`.
ALTO_TRANSCODE_WORKERS=1

# Re-index libraries at startup. Scanning is incremental, so a restart normally
# only walks and stats the tree; set to false to skip even that on very large or
# slow mounts — the UI's re-index button and POST /api/scan still work.
# Accepts true/false or 1/0; any other value aborts startup.
ALTO_SCAN_ON_START=true

# Maximum concurrent ffprobe processes during a scan, across all libraries.
# 0 (or unset) uses the built-in default: min(4, number of CPUs).
ALTO_SCAN_WORKERS=0

# Container timezone (affects logs / timestamps).
TZ=UTC
